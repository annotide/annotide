{
  "realm": "annotation",
  "enabled": true,
  "displayName": "Annotation dev SSO",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "groups": [
    {
      "name": "annotators"
    },
    {
      "name": "reviewers"
    },
    {
      "name": "platform-admins"
    }
  ],
  "clients": [
    {
      "clientId": "annotide",
      "name": "Annotide (dev)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-sso-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/api/v1/auth/oidc/callback",
        "http://localhost:5174/api/v1/auth/oidc/callback",
        "http://localhost:8000/api/v1/auth/oidc/callback",
        "http://localhost:8001/api/v1/auth/oidc/callback"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/login##http://localhost:5174/login"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "annotide-saml",
      "name": "Annotide SAML (dev)",
      "enabled": true,
      "protocol": "saml",
      "frontchannelLogout": false,
      "redirectUris": [
        "http://localhost:5173/api/v1/auth/saml/acs",
        "http://localhost:5174/api/v1/auth/saml/acs",
        "http://localhost:8000/api/v1/auth/saml/acs",
        "http://localhost:8001/api/v1/auth/saml/acs"
      ],
      "attributes": {
        "saml.assertion.signature": "true",
        "saml.server.signature": "true",
        "saml.client.signature": "false",
        "saml.authnstatement": "true",
        "saml.force.post.binding": "true",
        "saml.encrypt": "false",
        "saml_signature_algorithm": "RSA_SHA256",
        "saml_name_id_format": "persistent",
        "saml.force.name.id.format": "true"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "attribute.name": "email",
            "attribute.nameformat": "Basic",
            "friendly.name": "email"
          }
        },
        {
          "name": "givenName",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "firstName",
            "attribute.name": "givenName",
            "attribute.nameformat": "Basic"
          }
        },
        {
          "name": "surname",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "lastName",
            "attribute.name": "surname",
            "attribute.nameformat": "Basic"
          }
        },
        {
          "name": "groups",
          "protocol": "saml",
          "protocolMapper": "saml-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "attribute.name": "groups",
            "attribute.nameformat": "Basic",
            "full.path": "false",
            "single": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice.sso@example.com",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Annotator",
      "credentials": [
        {
          "type": "password",
          "value": "alice-dev-password",
          "temporary": false
        }
      ],
      "groups": [
        "annotators"
      ]
    },
    {
      "username": "carol",
      "enabled": true,
      "email": "carol.sso@example.com",
      "emailVerified": true,
      "firstName": "Carol",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "carol-dev-password",
          "temporary": false
        }
      ],
      "groups": [
        "platform-admins"
      ]
    },
    {
      "username": "erin",
      "enabled": true,
      "email": "erin.saml@example.com",
      "emailVerified": true,
      "firstName": "Erin",
      "lastName": "Saml",
      "credentials": [
        {
          "type": "password",
          "value": "erin-dev-password",
          "temporary": false
        }
      ],
      "groups": [
        "annotators"
      ]
    }
  ]
}
