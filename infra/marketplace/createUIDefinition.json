{
  "$schema": "https://schema.management.azure.com/schemas/0.1.2-preview/CreateUIDefinition.MultiVm.json#",
  "handler": "Microsoft.Azure.CreateUIDef",
  "version": "0.1.2-preview",
  "parameters": {
    "config": {
      "basics": {
        "resourceGroup": {
          "allowExisting": true
        }
      }
    },
    "basics": [
      {
        "name": "createNewCluster",
        "type": "Microsoft.Common.OptionsGroup",
        "label": "Create a new AKS cluster?",
        "defaultValue": "No",
        "toolTip": "Create new cluster",
        "constraints": {
          "allowedValues": [
            {
              "label": "Yes",
              "value": true
            },
            {
              "label": "No",
              "value": false
            }
          ],
          "required": true
        },
        "visible": true
      }
    ],
    "steps": [
      {
        "name": "clusterDetails",
        "label": "Cluster Details",
        "elements": [
          {
            "name": "existingClusterSection",
            "type": "Microsoft.Common.Section",
            "elements": [
              {
                "name": "clusterLookupControl",
                "type": "Microsoft.Solutions.ArmApiControl",
                "request": {
                  "method": "GET",
                  "path": "[concat(subscription().id, '/resourcegroups/', resourceGroup().name,  '/providers/Microsoft.ContainerService/managedClusters?api-version=2024-09-01')]"
                }
              },
              {
                "name": "existingClusterResourceName",
                "type": "Microsoft.Common.DropDown",
                "label": "AKS Cluster Name",
                "toolTip": "AKS Cluster Resource Name",
                "constraints": {
                  "allowedValues": "[map(steps('clusterDetails').existingClusterSection.clusterLookupControl.value, (item) => parse(concat('{\"label\":\"', item.name, '\",\"value\":\"', item.name, '\"}')))]",
                  "required": true
                }
              }
            ],
            "visible": "[equals(basics('createNewCluster'), false)]"
          },
          {
            "name": "newClusterSection",
            "type": "Microsoft.Common.Section",
            "elements": [
              {
                "name": "aksVersionLookupControl",
                "type": "Microsoft.Solutions.ArmApiControl",
                "request": {
                  "method": "GET",
                  "path": "[concat(subscription().id, '/providers/Microsoft.ContainerService/locations/', location(),  '/orchestrators?api-version=2019-04-01&resource-type=managedClusters')]"
                }
              },
              {
                "name": "newClusterResourceName",
                "type": "Microsoft.Common.TextBox",
                "label": "AKS cluster name",
                "defaultValue": "annotide-aks",
                "toolTip": "Use only allowed characters",
                "constraints": {
                  "required": true,
                  "regex": "^[a-zA-Z0-9][a-zA-Z0-9-]{4,28}[a-zA-Z0-9]$",
                  "validationMessage": "6-30 letters, digits or hyphens, starting and ending with a letter or digit."
                }
              },
              {
                "name": "kubernetesVersion",
                "type": "Microsoft.Common.DropDown",
                "label": "Kubernetes version",
                "toolTip": "The version of Kubernetes that should be used for this cluster. You will be able to upgrade this version after creating the cluster.",
                "constraints": {
                  "allowedValues": "[map(steps('clusterDetails').newClusterSection.aksVersionLookupControl.properties.orchestrators, (item) => parse(concat('{\"label\":\"', item.orchestratorVersion, '\",\"value\":\"', item.orchestratorVersion, '\"}')))]",
                  "required": true
                }
              },
              {
                "name": "vmSize",
                "type": "Microsoft.Compute.SizeSelector",
                "label": "VM size",
                "toolTip": "The size of virtual machine for VM.",
                "recommendedSizes": [
                  "Standard_D4s_v5",
                  "Standard_D4as_v5",
                  "Standard_D8s_v5",
                  "Standard_D4s_v3",
                  "Standard_B4ms"
                ],
                "constraints": {
                  "allowedSizes": [
                    "Standard_D4s_v5",
                    "Standard_D4as_v5",
                    "Standard_D8s_v5",
                    "Standard_D4s_v3",
                    "Standard_B4ms"
                  ],
                  "excludedSizes": []
                },
                "osPlatform": "Linux"
              },
              {
                "name": "osSKU",
                "type": "Microsoft.Common.DropDown",
                "label": "OS SKU",
                "toolTip": "The SKU of Linux OS for VM.",
                "defaultValue": "AzureLinux",
                "constraints": {
                  "allowedValues": [
                    {
                      "label": "Ubuntu",
                      "value": "Ubuntu"
                    },
                    {
                      "label": "AzureLinux",
                      "value": "AzureLinux"
                    }
                  ],
                  "required": true
                }
              },
              {
                "name": "enableAutoScaling",
                "type": "Microsoft.Common.CheckBox",
                "label": "Enable auto scaling",
                "toolTip": "Enable auto scaling",
                "defaultValue": true
              },
              {
                "name": "vmCount",
                "type": "Microsoft.Common.Slider",
                "min": 1,
                "max": 10,
                "label": "Node count",
                "subLabel": "",
                "defaultValue": 1,
                "showStepMarkers": false,
                "toolTip": "Specify VM count",
                "constraints": {
                  "required": false
                },
                "visible": true
              }
            ],
            "visible": "[basics('createNewCluster')]"
          }
        ]
      },
      {
        "name": "database",
        "label": "Database",
        "elements": [
          {
            "name": "databaseMode",
            "type": "Microsoft.Common.OptionsGroup",
            "label": "PostgreSQL and Redis",
            "defaultValue": "Deploy in the cluster",
            "toolTip": "In the cluster: the quickest start, for evaluations, pilots and small teams. Existing: Azure Database for PostgreSQL and Azure Managed Redis, for production.",
            "constraints": {
              "allowedValues": [
                {
                  "label": "Deploy in the cluster",
                  "value": "inCluster"
                },
                {
                  "label": "Use existing services",
                  "value": "existing"
                }
              ],
              "required": true
            }
          },
          {
            "name": "inClusterRisks",
            "type": "Microsoft.Common.InfoBox",
            "visible": "[equals(steps('database').databaseMode, 'inCluster')]",
            "options": {
              "icon": "Warning",
              "text": "PostgreSQL will run as a single pod on an Azure Disk in this cluster. Nothing backs it up: schedule backups to storage outside the cluster. Deleting the AKS cluster deletes the data. There is no failover: node failures and cluster upgrades cause minutes of downtime. For production, choose existing Azure Database for PostgreSQL and Azure Managed Redis.",
              "uri": "https://annotide.com/docs/helm/#risks-of-running-the-database-in-the-cluster"
            }
          },
          {
            "name": "acceptRisks",
            "type": "Microsoft.Common.CheckBox",
            "visible": "[equals(steps('database').databaseMode, 'inCluster')]",
            "label": "I understand that backups and availability of the in-cluster database are my responsibility.",
            "constraints": {
              "required": true,
              "validationMessage": "Acknowledge the in-cluster database risks, or choose existing services."
            },
            "toolTip": "The in-cluster PostgreSQL has no automatic backups or failover, and its data is deleted with the AKS cluster."
          },
          {
            "name": "zoneRedundant",
            "type": "Microsoft.Common.CheckBox",
            "visible": "[equals(steps('database').databaseMode, 'inCluster')]",
            "label": "Zone-redundant disk (ZRS; only in regions with availability zones)",
            "toolTip": "A ZRS disk keeps PostgreSQL's data available through an availability zone outage. Not offered in regions without zones."
          },
          {
            "name": "databaseUrl",
            "type": "Microsoft.Common.PasswordBox",
            "visible": "[equals(steps('database').databaseMode, 'existing')]",
            "label": {
              "password": "PostgreSQL 16 connection string",
              "confirmPassword": "Confirm"
            },
            "toolTip": "postgresql+asyncpg://user:password@server.postgres.database.azure.com:5432/annotation?ssl=require",
            "options": {
              "hideConfirmation": true
            },
            "constraints": {
              "required": true
            }
          },
          {
            "name": "redisUrl",
            "type": "Microsoft.Common.PasswordBox",
            "visible": "[equals(steps('database').databaseMode, 'existing')]",
            "label": {
              "password": "Redis connection string",
              "confirmPassword": "Confirm"
            },
            "toolTip": "rediss://:password@name.region.redis.azure.net:10000/0",
            "options": {
              "hideConfirmation": true
            },
            "constraints": {
              "required": true
            }
          }
        ]
      },
      {
        "name": "application",
        "label": "Annotide",
        "elements": [
          {
            "name": "extensionResourceName",
            "type": "Microsoft.Common.TextBox",
            "label": "Installation name",
            "defaultValue": "annotide",
            "toolTip": "The cluster extension's name, also its Helm release name.",
            "constraints": {
              "required": true,
              "regex": "^[a-z][a-z0-9-]{1,28}[a-z0-9]$",
              "validationMessage": "3-30 lowercase letters, digits or hyphens, starting with a letter."
            }
          },
          {
            "name": "licenseKey",
            "type": "Microsoft.Common.PasswordBox",
            "label": {
              "password": "Licence key (optional)",
              "confirmPassword": "Confirm"
            },
            "toolTip": "From annotide.com. Without a key Annotide runs as the free Community edition (up to 3 users); a 30-day trial can be started in the app.",
            "options": {
              "hideConfirmation": true
            },
            "constraints": {
              "required": false
            }
          },
          {
            "name": "publicAccess",
            "type": "Microsoft.Common.Section",
            "label": "Public address (optional)",
            "elements": [
              {
                "name": "accessInfo",
                "type": "Microsoft.Common.InfoBox",
                "options": {
                  "icon": "Info",
                  "text": "Leave the hostname empty to reach Annotide with kubectl port-forward. A hostname needs an ingress controller and cert-manager in the cluster already; Annotide is then served over HTTPS."
                }
              },
              {
                "name": "ingressHost",
                "type": "Microsoft.Common.TextBox",
                "label": "Hostname",
                "toolTip": "For example annotate.example.com; point its DNS at the ingress controller.",
                "constraints": {
                  "required": false,
                  "regex": "^$|^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,}$",
                  "validationMessage": "A lowercase DNS name, such as annotate.example.com."
                }
              },
              {
                "name": "ingressClassName",
                "type": "Microsoft.Common.TextBox",
                "label": "Ingress class",
                "defaultValue": "webapprouting.kubernetes.azure.com",
                "visible": "[not(empty(steps('application').publicAccess.ingressHost))]",
                "toolTip": "webapprouting.kubernetes.azure.com is the AKS application routing add-on.",
                "constraints": {
                  "required": true,
                  "regex": "^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$",
                  "validationMessage": "The name of an IngressClass in the cluster."
                }
              },
              {
                "name": "clusterIssuer",
                "type": "Microsoft.Common.TextBox",
                "label": "cert-manager ClusterIssuer",
                "visible": "[not(empty(steps('application').publicAccess.ingressHost))]",
                "toolTip": "Issues the hostname's TLS certificate, for example letsencrypt.",
                "constraints": {
                  "required": true,
                  "regex": "^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$",
                  "validationMessage": "The name of a ClusterIssuer."
                }
              }
            ]
          }
        ]
      }
    ],
    "outputs": {
      "location": "[location()]",
      "createNewCluster": "[basics('createNewCluster')]",
      "clusterResourceName": "[if(basics('createNewCluster'), steps('clusterDetails').newClusterSection.newClusterResourceName, steps('clusterDetails').existingClusterSection.existingClusterResourceName)]",
      "kubernetesVersion": "[coalesce(steps('clusterDetails').newClusterSection.kubernetesVersion, '')]",
      "vmSize": "[coalesce(steps('clusterDetails').newClusterSection.vmSize, 'Standard_D4s_v5')]",
      "osSKU": "[coalesce(steps('clusterDetails').newClusterSection.osSKU, 'AzureLinux')]",
      "vmEnableAutoScale": "[coalesce(steps('clusterDetails').newClusterSection.enableAutoScaling, true)]",
      "vmCount": "[coalesce(steps('clusterDetails').newClusterSection.vmCount, 1)]",
      "extensionResourceName": "[steps('application').extensionResourceName]",
      "databaseMode": "[steps('database').databaseMode]",
      "zoneRedundantDisk": "[coalesce(steps('database').zoneRedundant, false)]",
      "databaseUrl": "[coalesce(steps('database').databaseUrl, '')]",
      "redisUrl": "[coalesce(steps('database').redisUrl, '')]",
      "licenseKey": "[coalesce(steps('application').licenseKey, '')]",
      "ingressHost": "[coalesce(steps('application').publicAccess.ingressHost, '')]",
      "ingressClassName": "[coalesce(steps('application').publicAccess.ingressClassName, 'webapprouting.kubernetes.azure.com')]",
      "clusterIssuer": "[coalesce(steps('application').publicAccess.clusterIssuer, '')]"
    }
  }
}
