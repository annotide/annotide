# Copy to terraform.tfvars (gitignored) and fill in.
prefix     = "acme"
region     = "eu-north-1"
public_url = "https://annotate.acme.example"

# IAM roles or users that run kubectl / helm (e.g. your SSO admin role, CI).
cluster_admin_arns = ["arn:aws:iam::111122223333:role/AWSReservedSSO_AdministratorAccess_0123456789abcdef"]

# Restrict the Kubernetes API server's public endpoint (recommended).
api_authorized_ip_ranges = ["203.0.113.0/24"]

# Browsers fetch media straight from S3 (ARC-3): their public IPs or CIDRs,
# or [] for anyone (presigned URLs still required).
storage_allowed_ip_ranges = []

budget_amount         = 0
budget_contact_emails = []

tags = { environment = "prod" }
