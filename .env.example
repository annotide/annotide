# .env.example — copy to .env and adjust as needed:
#
#   cp .env.example .env && make dev
#
# Every APP_-prefixed variable below matches docs/CONTRACTS.md exactly
# (OPS-1). Variables marked "CHANGE FOR PRODUCTION" have a fine
# development-only default here but MUST be overridden with a real,
# secret value before this stack is ever run outside a local machine.
# Never commit a real .env file (see the repo's Security Principles).

# -----------------------------------------------------------------------
# Postgres (compose-only — consumed directly by the `postgres` service and
# assembled into APP_DATABASE_URL below; not read by the app itself)
# -----------------------------------------------------------------------
POSTGRES_USER=annotation
# CHANGE FOR PRODUCTION — local-only placeholder password.
POSTGRES_PASSWORD=annotation_dev_password
POSTGRES_DB=annotation

# -----------------------------------------------------------------------
# Backend / worker (APP_ prefix, read via pydantic-settings — OPS-1)
# -----------------------------------------------------------------------

# development | production
APP_ENV=development

# postgresql+asyncpg://... — must match the POSTGRES_* values above when
# running via docker-compose (service name "postgres", port 5432).
APP_DATABASE_URL=postgresql+asyncpg://annotation:annotation_dev_password@postgres:5432/annotation

# Redis connection for the arq queue (service name "redis" in compose).
APP_REDIS_URL=redis://redis:6379/0

# password: the credential is in the URLs above. entra: sign in to Azure
# Database for PostgreSQL / Azure Cache for Redis with a Microsoft Entra token
# for the managed identity, refreshed automatically; the URLs then carry no
# password (the database user is the Entra role name).
APP_DATABASE_AUTH=password
APP_REDIS_AUTH=password
# Client id of a user-assigned managed identity (entra auth and Key Vault).
# Empty: the system-assigned identity, or on AKS the workload identity.
APP_MANAGED_IDENTITY_CLIENT_ID=

# JWT signing key. CHANGE FOR PRODUCTION — generate with e.g.
# `openssl rand -hex 32`. Required (no safe default) once APP_ENV=production.
APP_SECRET_KEY=dev-only-insecure-secret-key-change-me
# Only while rotating APP_SECRET_KEY: the old value (see CONTRACTS.md).
APP_SECRET_KEY_PREVIOUS=

# Access token lifetime, seconds.
APP_ACCESS_TOKEN_TTL=3600
# AUTH-2: superusers signing in with a password must turn on an authenticator app.
APP_MFA_REQUIRED_FOR_ADMINS=false

# Signed media/blob URL lifetime, seconds (AUTH-6).
APP_SIGNED_URL_TTL=900
# How a model service reaches this API: the origin in front of local-connector
# media URLs sent to models (pre-labelling, smart polygon). Unset = root-relative
# URLs, which only the browser can fetch.
APP_INTERNAL_API_URL=http://backend:8000

# Task assignment lock duration, seconds (WF-3).
APP_TASK_LOCK_TTL=1800

# Comma-separated list of allowed CORS origins. Matches the frontend's
# dev-server / compose port (5173).
APP_CORS_ORIGINS=http://localhost:5173

# DEBUG | INFO | WARNING | ERROR
APP_LOG_LEVEL=INFO

# json | console (OPS-3) — use "console" for readable local dev logs.
APP_LOG_FORMAT=json

# Reverse proxies whose X-Forwarded-For / -Proto / -Host headers are believed
# (SEC-3): comma-separated IPs or CIDRs. Empty = trust nobody; the audit log
# then records the direct peer.
APP_TRUSTED_PROXIES=

# Request limits (API-5). These are the compose dev values, generous so E2E
# reruns pass; the app's production defaults are 1200 / 1200 / 10 per minute.
APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_PER_MINUTE=6000
APP_RATE_LIMIT_API_KEY_PER_MINUTE=6000
APP_RATE_LIMIT_LOGIN_PER_MINUTE=100

# OpenTelemetry traces and metrics to YOUR collector (OPS-3) — not vendor
# telemetry. Needs the backend `otel` extra (BACKEND_EXTRAS=otel); with the
# flag on and the extra missing, API and worker refuse to start. Exporter
# settings are the standard OTEL_* variables (OTEL_EXPORTER_OTLP_ENDPOINT, …).
APP_OTEL_ENABLED=false

# Background worker (ARC-4, DATA-2). Total attempts a job gets before it is
# marked failed; how many outbox rows the publisher claims per transaction (a
# tick drains the backlog batch by batch); and after how
# many failed attempts an outbox row is left for an operator to look at.
APP_JOB_MAX_TRIES=5
# Jobs of one project running at once; the rest wait in `queued`.
APP_JOB_MAX_RUNNING_PER_PROJECT=3
# DELETE /models/{id}: soft (keeps the rows, so pre-labels keep their author)
# or hard (removes them; refused while annotations name one of its versions).
APP_MODEL_DELETE_MODE=soft
APP_OUTBOX_POLL_BATCH_SIZE=50
APP_OUTBOX_MAX_ATTEMPTS=10

# Webhooks (API-4): delivery attempts per event, subscriber timeout (seconds)
# and how many due deliveries one worker tick sends.
APP_WEBHOOK_MAX_ATTEMPTS=8
APP_WEBHOOK_TIMEOUT=10
APP_WEBHOOK_POLL_BATCH_SIZE=50
# Per webhook; Slack takes about one message a second.
APP_WEBHOOK_MAX_PER_MINUTE=60
# Let webhooks reach private/loopback addresses (SEC-4). Compose defaults to
# true for the echo receiver; leave false in any real deployment.
APP_WEBHOOK_ALLOW_PRIVATE_URLS=true

# --- Notification e-mail (API-7) ----------------------------------------------
# Empty host = no e-mail. Locally: `make emulators`, then APP_SMTP_HOST=mailpit,
# APP_SMTP_PORT=1025, APP_SMTP_SECURITY=none, and read mail on :8025.
APP_SMTP_HOST=
APP_SMTP_PORT=587
APP_SMTP_SECURITY=starttls
APP_SMTP_USERNAME=
APP_SMTP_PASSWORD=
APP_SMTP_FROM=Annotide <noreply@localhost>
APP_NOTIFICATION_EMAIL_MAX_AGE=86400

# Thumbnails and tiles (IMG-8, IMG-1, IMG-2). Thumbnail size in px (longest
# side); images over 64 MiB get their thumbnail from the tile job instead.
# Images with at least APP_TILE_MIN_PIXELS pixels are tiled; sources over
# 12 GiB are not. APP_TILE_WORK_DIR (empty = system temp) needs room for about
# 1.5x the largest source.
APP_THUMBNAIL_SIZE=256
APP_THUMBNAIL_MAX_SOURCE_BYTES=67108864
APP_TILE_MIN_PIXELS=25000000
APP_TILE_MAX_SOURCE_BYTES=12884901888
APP_TILE_WORK_DIR=

# -----------------------------------------------------------------------
# Single sign-on (AUTH-1, AUTH-3) — optional; setting APP_OIDC_ISSUER turns it on
# -----------------------------------------------------------------------

# Where SSO sends the browser when it is done.
APP_FRONTEND_URL=http://localhost:5173

# Issuer URL; discovery is read from {issuer}/.well-known/openid-configuration.
# Keycloak dev realm: see docker-compose.sso.yml.
APP_OIDC_ISSUER=
# Required with the issuer.
APP_OIDC_CLIENT_ID=
# Optional — public clients use PKCE alone. CHANGE FOR PRODUCTION if set.
APP_OIDC_CLIENT_SECRET=
# Required with the issuer: the API's public callback, registered at the provider.
APP_OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/oidc/callback
APP_OIDC_SCOPES=openid profile email
# Label on the login button.
APP_OIDC_DISPLAY_NAME=Single sign-on
# Organisation new SSO users join. Empty = the only organisation (refused if
# there are several).
APP_OIDC_ORGANIZATION_SLUG=
# false = only users that already exist may sign in via SSO.
APP_OIDC_AUTO_PROVISION=true
# true = link an SSO sign-in to an existing account by e-mail even without
# email_verified in the ID token (Entra ID). Only if users cannot set their
# own address at the provider.
APP_OIDC_TRUST_UNVERIFIED_EMAIL=false
# ID token claim with the user's groups for role sync; empty = no group sync.
APP_OIDC_GROUPS_CLAIM=groups
# Comma-separated IdP groups whose members are superusers. Empty = superuser
# status is not managed by the IdP.
APP_OIDC_ADMIN_GROUPS=

# -----------------------------------------------------------------------
# Frontend (Vite VITE_ prefix — baked in at build time, not runtime)
# -----------------------------------------------------------------------

# Base URL the SPA calls for the API. In compose this is proxied by nginx
# (see frontend/nginx.conf), so a same-origin path is correct there; point
# it at http://localhost:8000/api/v1 instead when running the Vite dev
# server directly against a locally-running backend.
VITE_API_BASE_URL=/api/v1

# --- Licensing and telemetry (LIC-6, LIC-9, LIC-16, LIC-21) -----------------
# The heartbeat is on by default; set false to turn it off. It only ever sends
# salted hashes, never names or addresses. See docs/LICENSING.md; the admin can
# inspect the exact payload at GET /api/v1/licensing/telemetry/preview.
APP_TELEMETRY_ENABLED=true
# Licence key (LIC-1). Empty = Personal mode. Can also be pasted in the admin UI.
APP_LICENSE_KEY=
# Vendor licence server for the daily refresh (LIC-27) and the heartbeat. Empty
# = nothing is sent. The refresh is not telemetry; no licence check depends on
# reaching this server (LIC-28).
APP_LICENSE_SERVER_URL=
APP_LICENSE_REFRESH_ENABLED=true
# Stable identifier for this installation.
APP_INSTALL_ID=
# Vendor-wide HMAC salt for the organisation fingerprint. Built in and shared
# by design, not a secret; leave empty to use the built-in value.
APP_LICENSE_FINGERPRINT_SALT=
# Optional fingerprint inputs; leave blank if not applicable.
APP_PUBLIC_HOSTNAME=
APP_CLOUD_ACCOUNT_ID=
APP_SSO_TENANT_ID=

# --- Host ports ------------------------------------------------------------
# Only these are published to your machine. Change any that collide with
# something you already run. Postgres and Redis bind to 127.0.0.1 only.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173

# --- Local storage emulator (demo) -----------------------------------------
# Azurite's published development key. Not a secret: it only unlocks the local
# emulator. A real deployment uses a managed identity or a Key Vault reference.
AZURITE_HOST_PORT=10000
AZURITE_ACCOUNT_KEY=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==
# AWS (Moto) and GCS emulators plus a webhook echo receiver, `make emulators`
# (docs/LOCAL_CLOUDS.md). Changing the S3 or GCS port also means adding it to
# CSP_MEDIA_ORIGINS, or the browser blocks the media.
S3_EMULATOR_HOST_PORT=9100
GCS_EMULATOR_HOST_PORT=4443
WEBHOOK_SINK_HOST_PORT=8099

# --- Secret stores (AUTH-7) -------------------------------------------------
# A connector's secret_ref names WHERE its credential lives, e.g.
#   env:AZURE_STORAGE_KEY            file:/run/secrets/storage_key
#   azurekeyvault://acme-kv/key      awssecrets://prod/key?region=eu-west-1
#   gcpsecrets://acme-prod/key
APP_SECRET_CACHE_TTL=300
# Restrict file: references to one directory. Strongly recommended in production.
APP_SECRET_FILE_ROOT=
APP_AZURE_KEY_VAULT_NAME=
APP_AWS_REGION=

# --- Reference model service (§8) ------------------------------------------
# heuristic = offline demo detector (no weights). onnx = load MODEL_PATH.
MODEL_BACKEND=heuristic
MODEL_PATH=
# Optional: require `Authorization: Bearer <key>` on the model service (not /health, /ready).
# MODEL_API_KEY=
MODEL_HOST_PORT=9000

# --- ML platforms (API-6) ---------------------------------------------------
# `make mlflow` starts a local MLflow server (compose profile "mlflow"). The
# backend and worker need the `mlflow` extra to talk to it or to Databricks /
# Azure ML: build with BACKEND_EXTRAS=mlflow (comma-separate several extras,
# e.g. otel,mlflow). Register it in the app as tracking URI http://mlflow:5000
# with UI URL http://localhost:5001.
BACKEND_EXTRAS=
MLFLOW_HOST_PORT=5001

# Mailpit (`make emulators`): catches the app's notification e-mail.
MAILPIT_HOST_PORT=8025
